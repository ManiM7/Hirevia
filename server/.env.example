# ===== Server =====
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ===== MongoDB =====
MONGO_URI=mongodb://127.0.0.1:27017/jobbridge

# ===== Auth =====
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
COOKIE_NAME=jb_token

# ===== SMTP (Nodemailer) =====
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Hirevia <no-reply@hirevia.local>"

# ===== Uploads =====
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
MAX_RESUME_SIZE=5242880
MAX_PHOTO_SIZE=2097152

# ===== AI Summary (optional) =====
# If left blank, a deterministic rule-based summary generator is used instead.
AI_PROVIDER=
AI_API_KEY=

# ===== Rate limiting =====
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000

# ===== Google Calendar / Meet (interview scheduling) =====
# If left blank, scheduling an interview returns a clear setup error instead
# of ever creating a fake meeting link. See README for how to obtain
# GOOGLE_REFRESH_TOKEN via `npm run google:auth` (server/utils/googleAuthSetup.js).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=urn:ietf:wg:oauth:2.0:oob
GOOGLE_REFRESH_TOKEN=
